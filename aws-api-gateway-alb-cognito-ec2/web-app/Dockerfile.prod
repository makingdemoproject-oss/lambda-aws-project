# Production image — Vite build in stage 1, nginx static-serve in stage 2.
#
# Build with the right env-mode + secrets supplied at build time:
#
#   docker build -f Dockerfile.prod \
#     --build-arg VITE_API_BASE=https://api.rajesh-project.com \
#     --build-arg VITE_API_KEY=$ANONYMOUS_API_KEY \
#     -t web-app:prod .
#
# The container has no idea of the backend — every API call goes to
# VITE_API_BASE, baked into the JS at build time. No env vars at runtime.

# ── Stage 1: build ─────────────────────────────────────────────────────
FROM node:20-bookworm-slim AS build
WORKDIR /app

# Build args become Vite env vars during `npm run build:prod`.
ARG VITE_API_BASE
ARG VITE_API_KEY
ARG VITE_CASHFREE_RETURN_URL
ARG VITE_COOKIE_CONSENT=true
ENV VITE_API_BASE=${VITE_API_BASE}
ENV VITE_API_KEY=${VITE_API_KEY}
ENV VITE_CASHFREE_RETURN_URL=${VITE_CASHFREE_RETURN_URL}
ENV VITE_COOKIE_CONSENT=${VITE_COOKIE_CONSENT}

COPY package*.json ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN npm run build:prod

# ── Stage 2: serve ─────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime
# Strip the default vhost, drop ours in
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf

# The actual SPA build output
COPY --from=build /app/dist /usr/share/nginx/html

# Run as non-root (nginx official image already provisions this user)
USER nginx
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
