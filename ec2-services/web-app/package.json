{
  "name": "web-app",
  "version": "1.0.0",
  "description": "Single React SPA — rbac + ecommerce + chat + ride. Free OSM tiles via Leaflet.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "build:staging": "vite build --mode staging",
    "preview": "vite preview --host --port 5173",
    "deploy:s3": "aws s3 sync dist/ s3://${S3_BUCKET}/ --delete --cache-control 'public, max-age=31536000, immutable' --exclude index.html && aws s3 cp dist/index.html s3://${S3_BUCKET}/index.html --cache-control 'public, max-age=0, must-revalidate'",
    "deploy:invalidate": "aws cloudfront create-invalidation --distribution-id ${CF_DIST_ID} --paths '/*'"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "axios": "^1.7.7",
    "i18next": "^23.15.2",
    "i18next-browser-languagedetector": "^8.0.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.2",
    "react-leaflet": "^4.2.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.2",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.5"
  }
}
